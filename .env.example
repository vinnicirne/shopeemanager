# O modo local usa apenas loopback e dados de demonstração.
APP_MODE=local
PORT=4173
HOST=127.0.0.1
LOCAL_DATA_DIR=.data/store
LOCAL_PASSWORD=demonstracao
WORKER_INTERVAL_MS=1200

# Codex CLI no staging. Usa a autenticação já salva pelo comando codex login.
# STAGING_AI_PROVIDER=codex
# CODEX_WEB_RESEARCH=false
# CODEX_MODEL=
# CODEX_BIN=

# Produção. Configurar somente no serviço Node, com HTTPS na frente da API.
# APP_MODE=production
# HOST=0.0.0.0
# APP_ORIGIN=https://painel.exemplo.com
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Gemini opcional. Use o identificador e as tarifas do modelo liberado no projeto.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=
# GEMINI_RATE_DATE=2026-11-22
# MARKET_TRENDS_ENABLED=false

# Shopee opcional. Primeiro valide o app e a loja no sandbox.
# SHOPEE_ENV=sandbox
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# SHOPEE_TOKEN_KEY=
# SHOPEE_ENABLE_ADS=false
# SHOPEE_ENABLE_WRITES=false
