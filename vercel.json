{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "test \"$VERCEL_ENV\" = production && test -z \"$APP_ORIGIN\"",
  "functions": {
    "api/*.ts": { "maxDuration": 240 },
    "api/shopee/sync.ts": { "maxDuration": 240 }
  },
  "rewrites": [
    { "source": "/(login|tasks|sales|profit|reports|proposals|connections|settings)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/work", "schedule": "0 2 * * *" }]
}
